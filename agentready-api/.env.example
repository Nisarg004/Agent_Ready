# Copy this file to .env and fill in real values. Never commit .env.

PORT=5100
NODE_ENV=development
APP_URL=http://localhost:5100

# Frontend origins allowed by CORS (comma-separated)
FRONTEND_URLS=http://localhost:5173

# MongoDB connection string. Leave empty and use `npm run dev:memory`
# to run with a temporary in-memory database.
MONGODB_URI=

# Email delivery (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
LEAD_NOTIFY_EMAIL=

# Contact details shown in reports
CONTACT_WHATSAPP=
CONTACT_URL=https://www.codenixlabs.com/contact

# Scanner tuning (optional)
SCAN_TOTAL_TIMEOUT_MS=20000
SCAN_REQUEST_TIMEOUT_MS=10000
SCAN_CACHE_HOURS=1
SCAN_RATE_LIMIT_PER_HOUR=5
SCAN_MAX_KEY_PAGES=5
SCANNER_USER_AGENT=
