# Copy to agents/.env and fill in. Never commit .env.

# Secret phrase that gives the agent its fixed address (agent1q...).
# Any long random sentence. Keep it the same everywhere the agent runs.
AGENTREADY_AGENT_SEED=

# ASI:One API key from https://asi1.ai/dashboard/api-keys
# Used to understand chat messages. Without it the agent falls back to
# simple address detection.
ASI1_API_KEY=

# Must match AGENT_API_KEY on the AgentReady API, so the agent isn't held
# to the public 5-scans-per-hour limit.
AGENT_API_KEY=

AGENTREADY_API_URL=https://agentready-api-khag.onrender.com
AGENTREADY_WEB_URL=https://agentready-five-rust.vercel.app

# false = local only (testing). true = connect to Agentverse / ASI:One.
AGENT_MAILBOX=false
PORT=8001
AGENT_SCANS_PER_USER_PER_HOUR=25

# AgentReady Tester agent (its own secret phrase and port)
TESTER_AGENT_SEED=
TESTER_PORT=8002
TESTER_RUNS_PER_USER_PER_HOUR=25

# AgentReady asks the Tester (by address) to try shopping on every scanned site
TESTER_AGENT_ADDRESS=
TESTER_TIMEOUT_S=150
# Agents the Tester doesn't rate-limit (comma-separated), e.g. your AgentReady agent
TESTER_TRUSTED_AGENTS=

# AgentReady Fixer agent (its own secret phrase and port)
FIXER_AGENT_SEED=
FIXER_PORT=8003
# Repos the Fixer may change (comma-separated, wildcards allowed), e.g. you/shop,you/*-store.
# It never touches a repo that isn't listed, whoever asks.
FIXER_ALLOWED_REPOS=
# GitHub token with contents + pull-request write access to those repos.
# Leave empty to use this machine's GitHub CLI login (gh auth login).
GITHUB_TOKEN=
# ASI:One model for code changes, and where working copies go
FIXER_MODEL=asi1
FIXER_WORK_DIR=

# Shared memory and hand-offs between the three agents. On Railway this is the Redis service's
# REDIS_URL. Leave empty locally: memory then lives inside one process only.
REDIS_URL=
# true = after a failed shopping test on a site whose repo is allowed, the Fixer fixes it and opens
# the pull request on its own. false = it only prepares the plan and waits for "apply".
TEAM_AUTO_FIX=false
# true = the Fixer also merges its pull request (which deploys the store) without waiting for "merge".
# Agent merges are disabled even if a legacy TEAM_AUTO_MERGE flag is present.
# After a merge, the Tester checks the live site every VERIFY_WAIT_S seconds, up to VERIFY_TRIES times.
VERIFY_WAIT_S=90
VERIFY_TRIES=6

# Operator enrollment only: verify repo ownership and site association out of band.
# Exact authenticated chat sender IDs, repo names and site origins. No wildcards.
# Example: [{"requester":"agent1...","repo":"you/shop","site":"https://shop.example"}]
FIXER_REQUESTER_BINDINGS=[]
